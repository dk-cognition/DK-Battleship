@page "/debugging"
@using System.Reflection
@using Markdig

<PageTitle>BattleGolf &mdash; Debugging log</PageTitle>

<div class="panel debug-log">
    <div class="debug-log-head">
        <h2>Debugging log</h2>
        <a href="https://github.com/dk-cognition/DK-Battleship/blob/main/DEBUGGING.md" target="_blank" rel="noopener">View on GitHub</a>
    </div>

    @if (Log is null)
    {
        <p role="alert">Couldn't load the debugging log. It's also on GitHub.</p>
    }
    else
    {
        <article class="markdown">@Log</article>
    }

    <p class="debug-log-back">
        <a href="">&larr; Back to the first tee</a>
    </p>
</div>

@code {
    private static readonly MarkupString? Log = Render();

    private static MarkupString? Render()
    {
        using var stream = typeof(Debugging).Assembly.GetManifestResourceStream("DEBUGGING.md");

        if (stream is null)
        {
            return null;
        }

        using var reader = new StreamReader(stream);
        var pipeline = new MarkdownPipelineBuilder()
            .UseAdvancedExtensions()
            .DisableHtml()
            .Build();

        return new MarkupString(Markdown.ToHtml(reader.ReadToEnd(), pipeline));
    }
}
