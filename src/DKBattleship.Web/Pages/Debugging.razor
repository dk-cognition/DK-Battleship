@page "/debugging"
@using Markdig
@inject HttpClient Http

<PageTitle>BattleGolf &mdash; Debugging log</PageTitle>

<div class="panel debug-log">
    <div class="debug-log-head">
        <h2>Debugging log</h2>
        <a href="https://github.com/dk-cognition/DK-Battleship/blob/main/DEBUGGING.md" target="_blank" rel="noopener">View on GitHub</a>
    </div>

    @if (_error is not null)
    {
        <p role="alert">@_error</p>
    }
    else if (_html is null)
    {
        <p>Reading the scorecard&hellip;</p>
    }
    else
    {
        <article class="markdown">@_html</article>
    }

    <p class="debug-log-back">
        <a href="">&larr; Back to the first tee</a>
    </p>
</div>

@code {
    private static readonly MarkdownPipeline Pipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .DisableHtml()
        .Build();

    private MarkupString? _html;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var markdown = await Http.GetStringAsync("DEBUGGING.md");
            _html = new MarkupString(Markdown.ToHtml(markdown, Pipeline));
        }
        catch (HttpRequestException)
        {
            _error = "Couldn't load the debugging log. It's also on GitHub.";
        }
    }
}
