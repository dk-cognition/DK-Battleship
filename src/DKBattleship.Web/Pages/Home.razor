@page "/"
@using DKBattleship.Core
@using DKBattleship.Web.Components
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime Js

<PageTitle>BattleGolf</PageTitle>

<div class="sound-bar">
    <button type="button"
            class="tee ghost sound-toggle"
            aria-pressed="@(!_soundMuted)"
            title="@(_soundMuted ? "Turn sound on" : "Turn sound off")"
            @onclick="ToggleSound">
        @(_soundMuted ? "\U0001F507 Sound off" : "\U0001F50A Sound on")
    </button>
    <button type="button"
            class="tee ghost sound-toggle"
            aria-pressed="@_musicOn"
            title="@(_musicOn ? "Turn music off" : "Turn music on")"
            @onclick="ToggleMusic">
        @(_musicOn ? "\U0001F3B5 Music on" : "\U0001F3B5 Music off")
    </button>
</div>

@if (_game is null)
{
    <div class="panel">
        <h2>Pick your opponent</h2>
        <p>Four players, four skill levels. Pick the golfer you fancy your chances against.</p>
        <div class="characters">
            @foreach (var character in GolfCharacters.All)
            {
                <button type="button" class="character-card" @onclick="() => StartRound(character)">
                    <div class="avatar">@character.Avatar</div>
                    <div class="title">@character.Name</div>
                    <div><small>@character.Title</small></div>
                    <p>@character.Description</p>
                    <div class="handicap">
                        <span class="difficulty">Difficulty: @DifficultyLabel(character)</span>
                        <span class="tees">@TeeLabel(character)</span>
                    </div>
                </button>
            }
        </div>
    </div>
}
else
{
    <div class="panel status">
        <div>
            <div class="message">@_game.StatusMessage</div>
            <small>Opponent: @_game.Opponent.Avatar @_game.Opponent.Name &mdash; @_game.Opponent.Title</small>
        </div>
        <div class="scorecard">
            <div>Your swings: <span>@_game.PlayerSwings</span></div>
            <div>@(_game.Opponent.Name)'s swings: <span>@_game.AiSwings</span></div>
        </div>
    </div>

    @if (_game.IsOver)
    {
        <div class="panel game-over">
            <h2>@(_game.Status == GameStatus.PlayerWon ? "\U0001F3C6 You win the match!" : "\U0001F62C Match lost")</h2>
            <p>@_game.StatusMessage</p>
            <div class="controls" style="justify-content:center">
                <button class="tee" @onclick="() => StartRound(_game.Opponent)">Rematch @_game.Opponent.Name</button>
                <button class="tee ghost" @onclick="BackToRoster">Change opponent</button>
            </div>
        </div>
    }
    else if (_game.Status == GameStatus.Placing)
    {
        <div class="panel">
            <h2>Load the bag</h2>
            <p>
                Placing the <strong>@_game.NextShipToPlace!.Name</strong> (@_game.NextShipToPlace.Size cells),
                @(_orientation == Orientation.Horizontal ? "left to right" : "top to bottom").
                Click the cell where the club starts, or press <kbd>H</kbd> to rotate it.
            </p>
            <div class="controls">
                <button class="tee" @onclick="ToggleOrientation">Rotate (H)</button>
                <button class="tee ghost" @onclick="RandomPlacement">Let the caddie do it</button>
                <button class="tee ghost" @onclick="BackToRoster">Change opponent</button>
            </div>
        </div>

        <div class="panel boards">
            <div class="board-wrap">
                <h3>Your course</h3>
                <BoardGrid Board="_game.PlayerBoard"
                           RevealShips="true"
                           Clickable="true"
                           PreviewCells="PreviewCells()"
                           PreviewValid="PreviewIsValid()"
                           OnCellClick="PlaceShip"
                           OnCellHover="HoverCell" />
            </div>
            <div class="board-wrap">
                <h3>Still in the bag</h3>
                <ul class="bag">
                    @foreach (var ship in _game.ShipsToPlace)
                    {
                        <li><span>@ship.Name</span><span>@ship.Size</span></li>
                    }
                </ul>
            </div>
        </div>
    }
    else
    {
        <div class="panel boards">
            <div class="board-wrap">
                <h3>@_game.Opponent.Name's course <small>@(_game.Status == GameStatus.PlayerTurn ? "your swing" : "wait for the group ahead")</small></h3>
                <BoardGrid Board="_game.AiBoard"
                           Clickable="@(_game.Status == GameStatus.PlayerTurn)"
                           OnCellClick="Fire" />
                <ul class="bag">
                    @foreach (var ship in _game.AiBoard.Ships)
                    {
                        <li class="@(ship.IsSunk ? "sunk" : null)"><span>@ship.Name</span><span>@(ship.IsSunk ? "in the hole" : $"{ship.Hits.Count}/{ship.Size}")</span></li>
                    }
                </ul>
            </div>
            <div class="board-wrap">
                <h3>Your course</h3>
                <BoardGrid Board="_game.PlayerBoard" RevealShips="true" />
                <ul class="bag">
                    @foreach (var ship in _game.PlayerBoard.Ships)
                    {
                        <li class="@(ship.IsSunk ? "sunk" : null)"><span>@ship.Name</span><span>@(ship.IsSunk ? "in the hole" : $"{ship.Hits.Count}/{ship.Size}")</span></li>
                    }
                </ul>
            </div>
        </div>

        <div class="panel">
            <h3>Scorecard notes</h3>
            <div class="log">
                @foreach (var entry in _log)
                {
                    <p>@entry</p>
                }
            </div>
        </div>
    }
}

@code {
    private Game? _game;
    private Orientation _orientation = Orientation.Horizontal;
    private Coordinate? _hover;
    private readonly List<string> _log = new();
    private bool _aiSwinging;
    private DotNetObjectReference<Home>? _selfReference;
    private IJSObjectReference? _keyboard;
    private IJSObjectReference? _sound;
    private IJSObjectReference? _music;
    private bool _soundMuted;
    private bool _musicOn;

    private void StartRound(GolfCharacter character)
    {
        _game = new Game(character);
        _orientation = Orientation.Horizontal;
        _hover = null;
        _aiSwinging = false;
        _log.Clear();
    }

    private static string DifficultyLabel(GolfCharacter character) => character.ExpectedWinRate switch
    {
        >= 0.75 => "Impossible",
        >= 0.55 => "Hard",
        >= 0.35 => "Medium",
        _ => "Easy"
    };

    private static string TeeLabel(GolfCharacter character) => character.ExpectedWinRate switch
    {
        >= 0.75 => "Championship tees",
        >= 0.55 => "Back tees",
        >= 0.35 => "Member tees",
        _ => "Forward tees"
    };

    private void BackToRoster()
    {
        _game = null;
        _log.Clear();
    }

    private void ToggleOrientation() =>
        _orientation = _orientation == Orientation.Horizontal ? Orientation.Vertical : Orientation.Horizontal;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _selfReference = DotNetObjectReference.Create(this);
        _keyboard = await Js.InvokeAsync<IJSObjectReference>("import", "./js/keyboard.js");
        await _keyboard.InvokeVoidAsync("register", _selfReference);

        try
        {
            _sound = await Js.InvokeAsync<IJSObjectReference>("import", "./js/sound.js");
            _soundMuted = await _sound.InvokeAsync<bool>("isMuted");
            await _sound.InvokeVoidAsync("registerClickSounds");
            StateHasChanged();
        }
        catch (JSException)
        {
            _sound = null;
        }

        try
        {
            _music = await Js.InvokeAsync<IJSObjectReference>("import", "./js/music.js");
            _musicOn = await _music.InvokeAsync<bool>("init");
            StateHasChanged();
        }
        catch (JSException)
        {
            _music = null;
        }
    }

    private async Task ToggleMusic()
    {
        _musicOn = !_musicOn;
        if (_music is null)
        {
            return;
        }

        try
        {
            _musicOn = await _music.InvokeAsync<bool>("setMusicOn", _musicOn);
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task ToggleSound()
    {
        _soundMuted = !_soundMuted;
        if (_sound is null)
        {
            return;
        }

        try
        {
            _soundMuted = await _sound.InvokeAsync<bool>("setMuted", _soundMuted);
            await _sound.InvokeVoidAsync("unlock");
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
    }

    /// <summary>Fires a synthesized sound, ignoring any audio failure so play never breaks.</summary>
    private async Task PlaySound(string name, double delay = 0)
    {
        if (_sound is null || _soundMuted)
        {
            return;
        }

        try
        {
            await _sound.InvokeVoidAsync("play", name, delay);
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task PlayShotSounds(ShotResult result)
    {
        await PlaySound("swing");

        switch (result)
        {
            case ShotResult.Hit:
                await PlaySound("bang", 0.05);
                break;
            case ShotResult.Sunk:
                await PlaySound("splash", 0.06);
                break;
        }
    }

    [JSInvokable]
    public void HandleKey(string key)
    {
        if (_game?.Status != GameStatus.Placing)
        {
            return;
        }

        switch (key.ToLowerInvariant())
        {
            case "h":
            case "v":
            case "r":
                ToggleOrientation();
                StateHasChanged();
                break;
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_keyboard is not null)
            {
                await _keyboard.InvokeVoidAsync("unregister");
                await _keyboard.DisposeAsync();
            }

            if (_sound is not null)
            {
                await _sound.InvokeVoidAsync("unregisterClickSounds");
                await _sound.DisposeAsync();
            }

            if (_music is not null)
            {
                await _music.InvokeVoidAsync("stopMusic");
                await _music.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
        finally
        {
            _selfReference?.Dispose();
        }
    }

    private void HoverCell(Coordinate coordinate) => _hover = coordinate;

    private IReadOnlyCollection<Coordinate>? PreviewCells()
    {
        if (_game?.NextShipToPlace is null || _hover is null)
        {
            return null;
        }

        return Board.Span(_hover.Value, _game.NextShipToPlace.Size, _orientation)
            .Where(c => _game.PlayerBoard.InBounds(c))
            .ToList();
    }

    private bool PreviewIsValid() =>
        _game?.NextShipToPlace is not null && _hover is not null
        && _game.PlayerBoard.CanPlace(_game.NextShipToPlace, _hover.Value, _orientation);

    private async Task PlaceShip(Coordinate coordinate)
    {
        _game?.PlacePlayerShip(coordinate, _orientation);
        _hover = null;
        await PlaySound("click");
    }

    private void RandomPlacement()
    {
        _game?.RandomizePlayerShips();
        _hover = null;
    }

    private async Task Fire(Coordinate coordinate)
    {
        if (_game is null || _aiSwinging || _game.Status != GameStatus.PlayerTurn)
        {
            return;
        }

        var result = _game.PlayerFire(coordinate);
        if (result == ShotResult.AlreadyShot)
        {
            return;
        }

        _log.Insert(0, _game.StatusMessage);
        await PlayShotSounds(result);

        if (_game.Status != GameStatus.AiTurn)
        {
            return;
        }

        _aiSwinging = true;
        StateHasChanged();
        try
        {
            await Task.Delay(650);
            var aiShot = _game.AiFire();
            _log.Insert(0, _game.StatusMessage);
            await PlayShotSounds(aiShot.Result);
        }
        finally
        {
            _aiSwinging = false;
        }
    }
}
