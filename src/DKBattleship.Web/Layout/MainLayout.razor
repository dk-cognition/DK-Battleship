@inherits LayoutComponentBase

<div class="driving-range" aria-hidden="true">
    @for (var i = 0; i < BallCount; i++)
    {
        <span class="ball"></span>
    }
</div>

<div class="course">
    <header class="clubhouse">
        <span class="logo">&#9971;</span>
        <div>
            <h1>BattleGolf</h1>
            <p>Sink the bag before your opponent sinks yours.</p>
        </div>
    </header>

    <main>
        @Body
    </main>

    <footer>
        <a href="https://github.com/dk-cognition/DK-Battleship" target="_blank" rel="noopener">Source</a>
        <span>&middot;</span>
        <a href="https://github.com/dk-cognition/DK-Battleship/blob/main/DEBUGGING.md" target="_blank" rel="noopener">Debugging log</a>
    </footer>
</div>

@code {
    // One lane each; app.css styles .ball:nth-child(1..10).
    private const int BallCount = 10;
}
